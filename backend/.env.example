# ===== 필수 =====
OPENAI_API_KEY=sk-...
# 서비스 계정 키 JSON 전체를 한 줄로 (또는 base64 인코딩 문자열)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# 쉼표로 구분. 배포 후 Vercel 도메인 추가
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-app.vercel.app

# ===== 선택 =====
# 키 파일 경로 방식 (FIREBASE_SERVICE_ACCOUNT_JSON 대신)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
CHAT_HISTORY_LIMIT=10
DATA_NAME=일별 매출
DATA_UNIT=원
# memory = Firebase 없이 로컬 화면 테스트용 (서버 재시작 시 초기화)
STORAGE_BACKEND=firestore
